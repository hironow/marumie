###############################################
# Local development env template (.env.example)
#
# How to set this up for local dev:
# 1) Copy this file to both .env (seed 用) と .env.dev（migrate 用）
#    cp .env.example .env
#    cp .env.example .env.dev
# 2) Supabase を起動して各種キーを取得
#    pnpm run supabase:start
#    Studio を開く: http://127.0.0.1:54323 → Settings → API
#    -> Project URL, anon key（公開）, service role key（非公開）の各 JWT を使用
# 3) 下記の値を埋める（必要に応じて）
#
# 補足:
# - seed（prisma/seed.cjs）は .env を読み込みます（.env.dev は読みません）
# - migrate（pnpm run db:migrate）は .env.dev を読み込みます
# - Admin ランタイムは admin/.env.local を使用します（anon key はそちらへ）
# - これらのファイルは .gitignore 済みです（コミットしないでください）
###############################################

# Database Configuration（Studio もしくは `pnpm supabase:status` で確認、ポートは 54332）
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"

# Application Configuration
NODE_ENV="development"

# Optional: Use mock data in webapp
# USE_MOCK_DATA=true

# Supabase for seed/admin operations
# - URL: ローカル Supabase API の URL（デフォルト 54321）
# - SERVICE_ROLE_KEY: Studio → Settings → API の service_role key（JWT）
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Note for Admin runtime (set in admin/.env.local instead of here):
# SUPABASE_ANON_KEY="eyJ..."  # Studio → Settings → API の anon/public key（JWT）
