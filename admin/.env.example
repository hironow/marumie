###############################################
# Admin local env template (admin/.env.example)
#
# How to set up for local development:
# 1) Copy this file to .env.local
#    cp admin/.env.example admin/.env.local
# 2) Start Supabase and check keys in Studio
#    pnpm run supabase:start
#    Open Studio: http://127.0.0.1:54323 → Settings → API
#    -> Use Project URL, anon key, and service role key (all JWTs)
# 3) Fill values as needed and restart the dev server
#
# Notes:
# - SUPABASE_ANON_KEY = anon/public key (JWT) from Studio → Settings → API
# - SUPABASE_SERVICE_ROLE_KEY = service_role key (JWT) from Studio → Settings → API
# - Admin runtime uses this file. Seed/migrate use the root .env/.env.dev
# - Do NOT commit .env.local to git
###############################################

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY="eyJ..."                      # from Studio → Settings → API (anon key)
SUPABASE_SERVICE_ROLE_KEY="eyJ..."              # optional: from Studio → Settings → API (service_role)

# Cache refresh
DATA_REFRESH_TOKEN="your-secret-refresh-token"
WEBAPP_URL="http://localhost:3000"
SITE_URL="http://localhost:3001"

# Basic Authentication (optional)
# If set, enables basic auth for the entire application
# Value should be SHA256 hash of "id:password" format
# Example (macOS): echo -n "admin:password" | shasum -a 256 | awk '{print $1}'
# Example (Linux): echo -n "admin:password" | sha256sum | awk '{print $1}'
# Uncomment to enable:
# BASIC_AUTH_SECRET="<sha256_hex_of_id_colon_password>"

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"  # from Studio or status (port 54332)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
