###############################################
# Webapp local env template (webapp/.env.example)
#
# How to set up for local development:
# 1) Copy this file to .env.local
#    cp webapp/.env.example webapp/.env.local
# 2) (DB を使う機能向け) Supabase を起動して DB URL を確認
#    pnpm run supabase:start
#    pnpm run supabase:status   # -> Database URL のポートは 54332
# 3) 下の Database URL を status の値に合わせて設定
# 4) 開発サーバーを再起動
#
# Notes:
# - Webapp は `pnpm dev:webapp` で :3000 で起動
# - 多くの機能で DATABASE_URL/DIRECT_URL が必要
# - Supabase の鍵は通常 webapp では不要（Admin 側で使用）
# - Do NOT commit webapp/.env.local to git
###############################################

# Application URL
WEBAPP_URL="http://localhost:3000"

# Cache refresh (optional)
# DATA_REFRESH_TOKEN="your-secret-refresh-token"

# Google Analytics (optional)
# NEXT_PUBLIC_GA_TRACKING_ID="your-ga-tracking-id"

# ベーシック認証（オプション）
# 設定すると、webアプリ全体にベーシック認証を適用
# 値は "id:password" 形式の文字列をSHA256ハッシュ化したもの
# 例: echo -n "admin:password" | shasum -a 256
# BASIC_AUTH_SECRET="sha256_hash_of_id_password"

# Database Configuration (from `pnpm supabase:status` -> Database URL)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54332/postgres"
